# Copy these keys into .env.local and enter the credentials issued by Naver.
# Never commit .env.local or the real values.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: generate 32 random bytes encoded as 64 hex characters.
SIGNUP_PHONE_SECRET=
